{"nodes": [{"id": "_github_workflows_github_release_with_version_publish_workflow", "label": "Publish on GitHub with version (Workflow)", "file_type": "document", "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manually triggered (workflow_dispatch only) rather than on push/tag, because the release version is derived from the branch/ref name being dispatched \u2014 the maintainer picks which per-Minecraft-version branch to cut a release from."}, {"id": "_github_workflows_github_release_with_version_build_job", "label": "build Job (ubuntu-latest)", "file_type": "document", "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checks out with submodules: true and requests contents: write so the same job can build the artifact and create the GitHub release without a second job or elevated PAT."}, {"id": "_github_workflows_github_release_with_version_gradle_build", "label": "Gradle clean build Step", "file_type": "document", "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs ./gradlew clean build after a conditional chmod +x guarded by runner.os != 'Windows', so the workflow stays portable if the runner is ever switched to a Windows image."}, {"id": "_github_workflows_github_release_with_version_java_21_toolchain", "label": "Java 21 Temurin Toolchain", "file_type": "concept", "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JAVA_VERSION=21 is declared as a job-level env var and also hardcoded in setup-java; the env var exists so the same value can be forwarded to mc-publish as release metadata. Java 21 is the runtime baseline for Minecraft 1.21.x."}, {"id": "_github_workflows_github_release_with_version_version_scheme", "label": "Release Version Scheme (1.0.0-mc.<MC_VERSION>)", "file_type": "rationale", "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MC_VERSION is taken from github.ref_name, so releases are cut from per-Minecraft-version branches (e.g. 1.21.11) and encode the target game version in the tag. The mod version '1.0.0' is hardcoded in the shell step rather than read from gradle.properties, so it must be edited by hand for every release \u2014 a drift hazard against CHANGELOG.md and README.md."}, {"id": "_github_workflows_github_release_with_version_mc_publish", "label": "mc-publish Release Action", "file_type": "document", "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kir-Antipov/mc-publish@v3.3.0 is configured with only github-tag/github-token, so it publishes to GitHub Releases alone even though the same action can target Modrinth and CurseForge; loaders is pinned to fabric and game-versions to the branch-derived MC version."}], "edges": [{"source": "_github_workflows_github_release_with_version_publish_workflow", "target": "_github_workflows_github_release_with_version_build_job", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_github_release_with_version_build_job", "target": "_github_workflows_github_release_with_version_java_21_toolchain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_github_release_with_version_build_job", "target": "_github_workflows_github_release_with_version_gradle_build", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_github_release_with_version_build_job", "target": "_github_workflows_github_release_with_version_version_scheme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_github_release_with_version_build_job", "target": "_github_workflows_github_release_with_version_mc_publish", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_github_release_with_version_mc_publish", "target": "_github_workflows_github_release_with_version_version_scheme", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_github_release_with_version_mc_publish", "target": "_github_workflows_github_release_with_version_java_21_toolchain", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_github_release_with_version_mc_publish", "target": "changelog_colourscroller_1_0_0", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_github_release_with_version_version_scheme", "target": "changelog_colourscroller_1_0_0", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_github_release_with_version_gradle_build", "target": "readme_colourscroller", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".github/workflows/github_release_with_version.yml", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "release_publishing_flow", "label": "Manual Per-MC-Version Release Publishing Flow", "nodes": ["_github_workflows_github_release_with_version_publish_workflow", "_github_workflows_github_release_with_version_build_job", "_github_workflows_github_release_with_version_gradle_build", "_github_workflows_github_release_with_version_version_scheme", "_github_workflows_github_release_with_version_mc_publish", "changelog_colourscroller_1_0_0"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/github_release_with_version.yml"}]}